{
  "name": "@wrg/platform-frontends",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace @wrg/platform-client-web",
    "dev:admin": "npm run dev --workspace @wrg/platform-admin-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e:client": "npm run test:e2e --workspace @wrg/platform-client-web"
  }
}
