# New API. Keep this relative in production when the UI and API share a host.
VITE_API_BASE_URL=/v1
VITE_API_V1_BASE_URL=/api
VITE_ADMIN_APP_URL=https://admin.feedbackdatadashboard.com/admin/projects

# Local fixtures allow frontend development without staging or production data.
VITE_USE_API_FIXTURES=true

# When enabled, the login button only accepts the configured test username.
VITE_TEST_USERNAME_ENABLED=false
VITE_TEST_USERNAME=
